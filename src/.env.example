APP_NAME="Farmacia Asistencial"
APP_ENV=local
APP_KEY=
# En producción SIEMPRE false: evita mostrar trazas con detalles internos (OWASP A05).
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# Base estructurada (MySQL). En Docker el host es "mysql".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farmacia
DB_USERNAME=farmacia
DB_PASSWORD=farmacia_local

# Base no estructurada (MongoDB) para la bitácora de auditoría. En Docker: mongodb://mongo:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=farmacia_auditoria
AUDIT_DRIVER=mongodb

# Sesión: expira tras 30 min de inactividad y se guarda cifrada.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# En producción con HTTPS: true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# Contraseña de los usuarios de demostración creados por DemoSeeder.
DEMO_PASSWORD="Farmacia#Demo2026"

VITE_APP_NAME="${APP_NAME}"
